{
  "name": "@shelf/eslint-config",
  "version": "10.0.0",
  "description": "ESLint and Oxfmt config for Shelf projects",
  "license": "MIT",
  "repository": "shelfio/eslint-config",
  "author": {
    "name": "Vlad Holubiev",
    "email": "vlad@shelf.io",
    "url": "shelf.io"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "find-deadcode": "knip --no-progress",
    "test": "node --test",
    "prepare": "husky",
    "lint": "oxfmt && eslint . --fix",
    "lint:ci": "oxfmt --check && eslint .",
    "lint:profile": "node scripts/profile-eslint.mjs",
    "inspect-config": "eslint-config-inspector --config frontend.js",
    "inspect-config:build": "eslint-config-inspector build --config frontend.js --outDir .eslint-config-inspector",
    "audit:rules": "node scripts/audit-rules.mjs"
  },
  "files": [
    "common",
    "rules",
    "frontend.js",
    "typescript.js",
    "plugins",
    "oxfmt.js",
    "oxfmt.d.ts"
  ],
  "main": "typescript.js",
  "keywords": [
    "eslint",
    "eslintconfig",
    "oxfmt"
  ],
  "type": "module",
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint-plugin-barrel-files": "3.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jest-formatting": "4.0.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-shelf-no-need-lodash-methods": "2.0.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.14.0",
    "globals": "17.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  },
  "devDependencies": {
    "@eslint/config-inspector": "3.5.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "knip": "6.45.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.78.0"
  },
  "peerDependencies": {
    "eslint": "10.x"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{html,md,yml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,js,json}": [
      "eslint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.6.0"
}
